{
  "name": "DS_ADLS_Curated_Parquet",
  "properties": {
    "type": "Parquet",
    "linkedServiceName": { "referenceName": "LS_ADLS_Curated", "type": "LinkedServiceReference" },
    "parameters": {
      "report": { "type": "string" }
    },
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "curated",
        "folderPath": { "type": "string", "value": "@concat('manufacturing/', dataset().report)" }
      },
      "compressionCodec": "snappy"
    }
  }
}
